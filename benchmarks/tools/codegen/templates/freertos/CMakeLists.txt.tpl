    COMMAND ${{CMAKE_COMMAND}} -E echo "  Output:    {output_shape_str} ({output_size_bytes} bytes)"
    COMMAND ${{CMAKE_COMMAND}} -E echo "  Arena:     {arena_size_bytes} bytes (SRAM)"
    COMMAND ${{CMAKE_COMMAND}} -E echo "  Weights:   {weights_flash_bytes} bytes (Flash)"
    COMMAND ${{CMAKE_COMMAND}} -E echo "  Peak SRAM: {peak_sram_bytes} bytes"
    COMMAND ${{CMAKE_COMMAND}} -E echo "  MACs:      {total_macs}"
    COMMAND ${{CMAKE_COMMAND}} -E echo "  Est. time: {estimated_us} us @ {clock_mhz} MHz"
    COMMAND ${{CMAKE_COMMAND}} -E echo ""
    VERBATIM
)
