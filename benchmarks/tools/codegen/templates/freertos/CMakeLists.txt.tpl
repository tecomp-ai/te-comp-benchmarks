cmake_minimum_required(VERSION 3.16)

# --- Library: {model_name}_inference ---
add_library({model_name}_inference STATIC
    {engine_source}
    inference_task.c
)

target_include_directories({model_name}_inference PUBLIC
    ${{CMAKE_CURRENT_SOURCE_DIR}}
)

# Engine needs arm-none-eabi intrinsics (SMLAD, SXTB16) — these come
# from the compiler, not a library. Just need the right -mcpu flag.
target_compile_options({model_name}_inference PRIVATE
    -mcpu={target}
    -mfloat-abi=hard
    -mfpu=fpv4-sp-d16
    -mthumb
    -Os
    -Wall
    -ffunction-sections
    -fdata-sections
)

target_compile_definitions({model_name}_inference PRIVATE
    ARM_MATH_DSP
)

# FreeRTOS headers — user must provide these.
# If using STM32CubeMX, they're in Middlewares/Third_Party/FreeRTOS/...
# If using vanilla FreeRTOS, set FREERTOS_INCLUDE_DIR in your top-level CMake.
if(DEFINED FREERTOS_INCLUDE_DIR)
    target_include_directories({model_name}_inference PRIVATE
        ${{FREERTOS_INCLUDE_DIR}}
    )
endif()

# --- Info target: print model stats ---
add_custom_target({model_name}_info
    COMMAND ${{CMAKE_COMMAND}} -E echo ""
    COMMAND ${{CMAKE_COMMAND}} -E echo "  Model:     {model_name}"
